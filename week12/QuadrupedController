import pybullet as p
import pybullet_data
import time
import math

# =====================================
# 初始化
# =====================================

p.connect(p.GUI)

p.setAdditionalSearchPath(pybullet_data.getDataPath())

p.setGravity(0, 0, -9.8)

plane = p.loadURDF("plane.urdf")

# 地面摩擦
p.changeDynamics(
    plane,
    -1,
    lateralFriction=4.0
)

# =====================================
# 机器人初始状态（四脚朝天）
# =====================================

start_pos = [0, 0, 0.15]

upside_down = p.getQuaternionFromEuler([math.pi, 0, 0])

robot = p.loadURDF(
    "laikago/laikago_toes.urdf",
    start_pos,
    upside_down
)

# 机器人摩擦
for i in range(p.getNumJoints(robot)):

    p.changeDynamics(
        robot,
        i,
        lateralFriction=4.0,
        spinningFriction=0.1,
        rollingFriction=0.1
    )

# =====================================
# 四条腿
# =====================================

LF = [0, 1, 2]
RF = [4, 5, 6]
LH = [8, 9, 10]
RH = [12, 13, 14]

legs = {
    "LF": LF,
    "RF": RF,
    "LH": LH,
    "RH": RH
}

# =====================================
# 控制函数
# =====================================

def set_leg(leg, hip, thigh, calf, force=180):

    targets = [hip, thigh, calf]

    for joint, angle in zip(leg, targets):

        p.setJointMotorControl2(
            robot,
            joint,
            p.POSITION_CONTROL,
            targetPosition=angle,
            force=force
        )

# =====================================
# 展示：先四脚朝天躺2秒
# =====================================

print("机器人四脚朝天...")

for _ in range(480):

    p.stepSimulation()

    time.sleep(1/240)

# =====================================
# 自动翻正（核心）
# =====================================

print("机器人自动翻身...")

upright = p.getQuaternionFromEuler([0, 0, 0])

p.resetBasePositionAndOrientation(
    robot,
    [0, 0, 0.35],
    upright
)

# =====================================
# 缓慢站起来
# =====================================

print("机器人站起来...")

for t in range(800):

    ratio = t / 800

    thigh = 1.4 - 0.6 * ratio

    calf = -2.3 + 0.8 * ratio

    for leg in legs.values():

        set_leg(
            leg,
            0,
            thigh,
            calf,
            force=180
        )

    p.stepSimulation()

    time.sleep(1/240)

# =====================================
# 稳定站立
# =====================================

print("稳定站立...")

for _ in range(400):

    for leg in legs.values():

        set_leg(
            leg,
            0,
            0.8,
            -1.5,
            force=180
        )

    p.stepSimulation()

    time.sleep(1/240)

# =====================================
# 真正稳定 walking
# =====================================

print("开始四足 walking...")

walk_order = ["LF", "RH", "RF", "LH"]

step_frames = 100

while True:

    for move_leg_name in walk_order:

        for frame in range(step_frames):

            s = frame / step_frames

            for leg_name, leg in legs.items():

                # 默认支撑姿态
                hip = 0
                thigh = 0.82
                calf = -1.55

                # ==========================
                # 摆动腿
                # ==========================
                if leg_name == move_leg_name:

                    # 向前迈腿
                    hip = 0.28 * math.sin(math.pi * s)

                    # 抬腿
                    thigh = 0.82 - 0.18 * math.sin(math.pi * s)

                    calf = -1.55 + 0.25 * math.sin(math.pi * s)

                # ==========================
                # 支撑腿
                # ==========================
                else:

                    # 向后蹬地
                    hip = -0.12 * math.sin(math.pi * s)

                    thigh = 0.84

                    calf = -1.58

                set_leg(
                    leg,
                    hip,
                    thigh,
                    calf,
                    force=180
                )

            p.stepSimulation()

            time.sleep(1/240)