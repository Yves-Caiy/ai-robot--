import pybullet as p
import pybullet_data
import time
import math

# =========================
# 初始化
# =========================

p.connect(p.GUI)

p.setAdditionalSearchPath(pybullet_data.getDataPath())

p.setGravity(0, 0, -9.8)

plane = p.loadURDF("plane.urdf")

# 增加地面摩擦
p.changeDynamics(plane, -1, lateralFriction=3.0)

# =========================
# 加载机器人（先翻倒）
# =========================

start_pos = [0, 0, 0.22]

start_orientation = p.getQuaternionFromEuler([math.pi, 0, 0])

robot = p.loadURDF(
    "laikago/laikago_toes.urdf",
    start_pos,
    start_orientation
)

# 增加机器人摩擦
for i in range(p.getNumJoints(robot)):
    p.changeDynamics(
        robot,
        i,
        lateralFriction=3.0
    )

# =========================
# 真实关节
# =========================

LF = [0, 1, 2]
RF = [4, 5, 6]
LH = [8, 9, 10]
RH = [12, 13, 14]

legs = {
    "LF": LF,
    "RF": RF,
    "LH": LH,
    "RH": RH
}

# =========================
# 控制函数
# =========================

def set_leg(leg, hip, thigh, calf, force=220):

    targets = [hip, thigh, calf]

    for joint, angle in zip(leg, targets):

        p.setJointMotorControl2(
            robot,
            joint,
            p.POSITION_CONTROL,
            targetPosition=angle,
            force=force
        )

# =========================
# 翻身阶段
# =========================

print("机器人开始翻身...")

for t in range(1000):

    set_leg(LF, 1.0, 1.5, -2.5)
    set_leg(RF, -1.0, 1.5, -2.5)

    set_leg(LH, -1.0, 1.5, -2.5)
    set_leg(RH, 1.0, 1.5, -2.5)

    p.stepSimulation()

    time.sleep(1/240)

# =========================
# 缓慢站立
# =========================

print("机器人开始站立...")

for t in range(800):

    ratio = t / 800

    thigh = 1.5 - 0.7 * ratio

    calf = -2.5 + 1.0 * ratio

    for leg in legs.values():

        set_leg(
            leg,
            0,
            thigh,
            calf
        )

    p.stepSimulation()

    time.sleep(1/240)

# =========================
# 稳定站立
# =========================

print("稳定站立...")

for t in range(500):

    for leg in legs.values():

        set_leg(
            leg,
            0,
            0.8,
            -1.5
        )

    p.stepSimulation()

    time.sleep(1/240)

# =========================
# 真正稳定四足 walking
# 一次只移动一条腿
# =========================

print("开始稳定四足行走...")

walk_order = ["LF", "RH", "RF", "LH"]

step_frames = 180

while True:

    for move_leg_name in walk_order:

        # 抬腿阶段
        for frame in range(step_frames):

            s = frame / step_frames

            for leg_name, leg in legs.items():

                # 默认支撑姿态
                hip = 0
                thigh = 0.8
                calf = -1.5

                # 当前移动腿
                if leg_name == move_leg_name:

                    # 前摆
                    hip = 0.25 * math.sin(math.pi * s)

                    # 抬腿
                    thigh = 0.8 - 0.18 * math.sin(math.pi * s)

                    calf = -1.5 + 0.25 * math.sin(math.pi * s)

                else:

                    # 支撑腿压低
                    thigh = 0.82
                    calf = -1.55

                set_leg(
                    leg,
                    hip,
                    thigh,
                    calf,
                    force=220
                )

            p.stepSimulation()

            time.sleep(1/240)